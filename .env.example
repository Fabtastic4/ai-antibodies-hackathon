# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# viz/japanfold.py reads .env automatically, so nothing needs exporting. A real shell
# variable overrides the file if you ever need to.

# JapanFold. Team key: 'japanfold-oslo-hackathon-codes 4.txt' in the Slack folder.
# A personal key (with $100 credit) comes from https://japanfold.aiand.com/account/token
JAPANFOLD_API_KEY=
# Optional. Defaults to https://api.japanfold.aiand.com/v1; the /v1 suffix is added for you.
JAPANFOLD_BASE_URL=https://api.japanfold.aiand.com

# Optional — Apheris Foundry on the VM, for lane=vm. See docs/tools-apheris.md.
# FOUNDRY_SSH=user@vm-host
# FOUNDRY_MODEL=openfold3

# Optional — point at the Nebius credentials if they are not in the parent folder.
# NEBIUS_CREDS=/absolute/path/to/credentials.private.json
