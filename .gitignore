.DS_Store
.env
.venv/

# SECRETS — never commit. Everyone gets these from the Slack folder instead.
*.private.json
credentials*.json
Files from slack/
**/japanfold*codes*
*.pem
id_*
team-4*
__pycache__/
*.pyc

# Run ids and score tables ARE the provenance for every number we report, so they are
# committed deliberately (START-HERE.md, SETUP.md §8). Only the blobs inside them are ignored.
# They hold no keys — keys are covered by the SECRETS block above and stay ignored everywhere.
nebius-runs/**/*.cif
nebius-runs/**/*.pdb
nebius-runs/**/*.tar
nebius-runs/**/*.gz
results/**/*.cif
results/**/*.pdb
results/**/*.tar
results/**/*.gz

# Large or regenerable artifacts — keep paths and provenance in the repo, not the blobs
data/**/*.cif
data/**/*.pdb
data/**/*.mmcif
data/**/*.gz
!data/**/README.md
*.pt
*.ckpt

# Bucket data pulled from the VM: review before committing (see scripts/pull_vm_data.sh)
data/bucket/committable.tar.gz
data/bucket/extracted/**/*.csv.gz
nebius-runs/

# A local full copy of the bucket, ~5 GB, if one is made outside data/bucket/
# (scripts/vm_inventory_data.sh syncs to $HOME/hackathon-data on the VM; issue #5).
# The tables are regenerable from s3://apheris-oslo-hackathon, so only the fetch
# manifest - the record of which copy a number came from - is worth versioning.
hackathon-data/*
!hackathon-data/fetch_manifest.json

# model weights are distributed outside git (see pipeline/score/affinity_v2/README.md)
models/
.inference_token*
