.DS_Store
.env
.venv/

# SECRETS — never commit. Everyone gets these from the Slack folder instead.
*.private.json
credentials*.json
Files from slack/
**/japanfold*codes*
*.pem
id_*
team-4*
nebius-runs/
results/
__pycache__/
*.pyc

# Large or regenerable artifacts — keep paths and provenance in the repo, not the blobs
data/**/*.cif
data/**/*.pdb
data/**/*.mmcif
data/**/*.gz
!data/**/README.md
*.pt
*.ckpt

# The hackathon bucket copy, ~5 GB (scripts/fetch_hackathon_data.py, issue #5).
# The tables are regenerable from s3://apheris-oslo-hackathon; the fetch
# manifest is the provenance record of which copy a number came from, so that
# one file IS committed.
hackathon-data/*
!hackathon-data/fetch_manifest.json
