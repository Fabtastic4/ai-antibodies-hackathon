.DS_Store
.env
.venv/

# SECRETS — never commit. Everyone gets these from the Slack folder instead.
*.private.json
credentials*.json
Files from slack/
**/japanfold*codes*
*.pem
id_*
team-4*
__pycache__/
*.pyc

# Run ids and score tables ARE the provenance for every number we report, so they are
# committed deliberately (START-HERE.md, SETUP.md §8). Only the blobs inside them are ignored.
# They hold no keys — keys are covered by the SECRETS block above and stay ignored everywhere.
nebius-runs/**/*.cif
nebius-runs/**/*.pdb
nebius-runs/**/*.tar
nebius-runs/**/*.gz
results/**/*.cif
results/**/*.pdb
results/**/*.tar
results/**/*.gz

# Large or regenerable artifacts — keep paths and provenance in the repo, not the blobs
data/**/*.cif
data/**/*.pdb
data/**/*.mmcif
data/**/*.gz
!data/**/README.md
*.pt
*.ckpt

# Bucket data pulled from the VM: review before committing (see scripts/pull_vm_data.sh)
data/bucket/committable.tar.gz
data/bucket/extracted/**/*.csv.gz
